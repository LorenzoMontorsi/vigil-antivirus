;;;
;;; VigilFlt - minifilter di protezione in tempo reale di Vigil
;;;
;;; ALTITUDINE: 328500 è un valore provvisorio (328010 è di Microsoft Defender!) nella fascia "FSFilter Anti-Virus"
;;; (320000-329998). Per distribuire il driver va richiesta un'altitudine
;;; ufficiale a Microsoft (fsfcomm@microsoft.com).
;;;

[Version]
Signature   = "$WINDOWS NT$"
Class       = "AntiVirus"
ClassGuid   = {b1d1a169-c54f-4379-81db-bee7d88d7454}
Provider    = %ManufacturerName%
DriverVer   = 11/02/2026,0.1.0.0
CatalogFile = VigilFlt.cat
PnpLockdown = 1

[DestinationDirs]
DefaultDestDir = 13

[DefaultInstall.NTamd64]
OptionDesc = %ServiceDescription%
CopyFiles  = VigilFlt.DriverFiles

[DefaultInstall.NTamd64.Services]
AddService = %ServiceName%,,VigilFlt.Service

[DefaultUninstall.NTamd64]
LegacyUninstall = 1

[DefaultUninstall.NTamd64.Services]
DelService = %ServiceName%,0x200

[VigilFlt.Service]
DisplayName      = %ServiceName%
Description      = %ServiceDescription%
ServiceBinary    = %13%\VigilFlt.sys
Dependencies     = "FltMgr"
ServiceType      = 2                ; SERVICE_FILE_SYSTEM_DRIVER
StartType        = 3                ; SERVICE_DEMAND_START (in fase di test si carica a mano)
ErrorControl     = 1
LoadOrderGroup   = "FSFilter Anti-Virus"
AddReg           = VigilFlt.AddRegistry

[VigilFlt.AddRegistry]
HKR,"Parameters","SupportedFeatures",0x00010001,0x3
HKR,"Parameters\Instances","DefaultInstance",0x00000000,%DefaultInstance%
HKR,"Parameters\Instances\"%Instance1.Name%,"Altitude",0x00000000,%Instance1.Altitude%
HKR,"Parameters\Instances\"%Instance1.Name%,"Flags",0x00010001,%Instance1.Flags%

[VigilFlt.DriverFiles]
VigilFlt.sys

[SourceDisksFiles]
VigilFlt.sys = 1,,

[SourceDisksNames]
1 = %DiskId1%,,,

[Strings]
ManufacturerName   = "Vigil"
ServiceName        = "VigilFlt"
ServiceDescription = "Vigil - protezione in tempo reale"
DiskId1            = "Vigil"
DefaultInstance    = "VigilFlt Instance"
Instance1.Name     = "VigilFlt Instance"
Instance1.Altitude = "328500"
Instance1.Flags    = 0x0
